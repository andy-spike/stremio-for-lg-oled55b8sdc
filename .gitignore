# Build output (tools/build-ipk.py)
dist/

# runtime/ mirrors /media/developer/stremio on the TV. Only our own files
# are tracked; the ~140 MB of third-party binaries are local-only.
# Sources: runtime/README.md.
runtime/*
!runtime/README.md
!runtime/bin/
runtime/bin/*
!runtime/bin/stremio-service
!runtime/bin/stremio-update
!runtime/bin/update.js
!runtime/bin/patch-server.js

# Sample video for preview/player.html (24 MB); any short .webm works
preview/clip.webm

