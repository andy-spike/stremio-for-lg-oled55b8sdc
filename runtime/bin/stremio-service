#!/bin/sh
# Starts and stops the Stremio streaming server on the TV.
#
#   stremio-service start    start the server (no-op if running) and its watchdog
#   stremio-service stop     stop the server and the watchdog
#   stremio-service status   print "running" or "stopped"
#
# Lives in /media/developer/stremio/bin, owned by root. The Stremio app calls it
# through Homebrew Channel's root exec service. The server itself runs as
# "nobody", listens only on 127.0.0.1:11470, and keeps torrent data in a small
# memory buffer instead of on the TV's flash storage.
#
# The watchdog stops the server once the Stremio app has not been running for
# IDLE_LIMIT seconds, so nothing keeps downloading after you close the app.

ROOT=/media/developer/stremio
UPD=$ROOT/updates
PIDFILE=/tmp/stremio-server.pid
WATCHPID=/tmp/stremio-watchdog.pid
LOG=/tmp/stremio-server.log
APP_ID=com.local.stremio
IDLE_LIMIT=300
# Node memory. The TV has ~250 MB free with swap in use. The server's live
# heap is ~50 MB, but a 256 MB cap let it grow to ~200 MB while streaming
# before collecting. A lower cap, a small young generation and
# --optimize-for-size keep it collecting early. (Torrent data lives in
# Buffers, outside this limit.)
NODE_MEMORY="--max-old-space-size=160 --max-semi-space-size=2 --optimize-for-size"

server_pid() {
  [ -f "$PIDFILE" ] || return 1
  pid=$(cat "$PIDFILE")
  [ -n "$pid" ] && [ -d "/proc/$pid" ] && grep -q server.js "/proc/$pid/cmdline" 2>/dev/null && echo "$pid"
}

# The watchdog's pid, if that process is still our watchdog. Pids get reused,
# so a stale pidfile must never lead to killing some other program.
watchdog_pid() {
  [ -f "$WATCHPID" ] || return 1
  pid=$(cat "$WATCHPID")
  [ -n "$pid" ] && [ -d "/proc/$pid" ] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "stremio-service watchdog" && echo "$pid"
}

watchdog() {
  idle=0
  while server_pid >/dev/null; do
    sleep 30
    if luna-send -n 1 -f luna://com.webos.applicationManager/running '{}' < /dev/null 2>/dev/null | grep -q "\"$APP_ID\""; then
      idle=0
    else
      idle=$((idle + 30))
      [ "$idle" -ge "$IDLE_LIMIT" ] && { stop_server; break; }
    fi
    # The server logs every request; keep the RAM-backed log small. Trim in
    # place: the server appends to the open file, so replacing it would leak.
    [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ] && tail -n 200 "$LOG" > "$LOG.tmp" && cat "$LOG.tmp" > "$LOG" && rm -f "$LOG.tmp"
  done
}

start_server() {
  start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/bin/python -- -c 'import os,sys; os.closerange(3,65536); os.execv("/bin/sh", ["/bin/sh"] + sys.argv[1:])' "$0" run-server
}

# True if something listens on the server's ports (11470-11474, hex
# 2CCE-2CD2) on an address other than 127.0.0.1.
exposed() {
  awk '$4 == "0A" && $2 ~ /:2C(CE|CF|D0|D1|D2)$/ && $2 !~ /^0100007F:/' /proc/net/tcp /proc/net/tcp6 2>/dev/null | grep -q .
}

# Waits up to 60 s for the server to answer on 127.0.0.1 only.
answers() {
  i=0
  while [ $i -lt 60 ]; do
    if curl -s -o /dev/null --max-time 2 http://127.0.0.1:11470/settings; then
      exposed && return 1
      return 0
    fi
    server_pid >/dev/null || [ $i -lt 3 ] || return 1   # it exited
    sleep 1; i=$((i + 1))
  done
  return 1
}

stop_server() {
  pid=$(server_pid) && kill "$pid" 2>/dev/null
  rm -f "$PIDFILE"
  # ffmpeg conversions outlive the server if it is killed; stop ours too.
  # ffmpeg treats SIGTERM as "finish cleanly" and ignores it while blocked on
  # I/O, so follow up with SIGKILL.
  for sig in TERM KILL; do
    for p in $(pidof ffmpeg ffprobe); do
      case "$(readlink "/proc/$p/exe")" in
        "$ROOT/bin/ffmpeg"|"$ROOT/bin/ffprobe") kill -s "$sig" "$p" 2>/dev/null ;;
      esac
    done
    [ "$sig" = TERM ] && sleep 2
  done
}

case "$1" in
  start)
    # This TV's start-stop-daemon -b retains inherited service descriptors.
    # Close them explicitly before starting either long-lived child.
    if ! server_pid >/dev/null; then
      mkdir -p "$ROOT/data" && chown nobody "$ROOT/data"
      : > "$LOG"
      start_server
      # A just-updated server (bin/update.js) must answer before it counts as
      # good; if it doesn't, go back to the previous one and skip this version.
      if [ -f "$UPD/pending" ]; then
        if answers; then
          rm -f "$UPD/pending"
        elif [ -f "$UPD/server.prev.js" ]; then
          echo "server $(cat "$UPD/pending") did not start; going back" >> "$UPD/log"
          stop_server
          cat "$UPD/pending" >> "$UPD/skip"
          mv "$UPD/server.prev.js" "$ROOT/server.js"
          rm -f "$UPD/pending"
          : > "$LOG"
          start_server
        fi
      fi
    fi
    if ! watchdog_pid >/dev/null; then
      start-stop-daemon -S -b -m -p "$WATCHPID" -x /usr/bin/python -- -c 'import os,sys; os.closerange(3,65536); os.execv("/bin/sh", ["/bin/sh"] + sys.argv[1:])' "$0" watchdog
    fi
    echo started
    ;;
  run-server)
    # Internal: replaced by the server process, so the pidfile holds its pid.
    cd "$ROOT/data" || exit 1
    exec env HOME="$ROOT/data" APP_PATH="$ROOT/data" \
      NO_HTTPS_SERVER=1 CASTING_DISABLED=1 DISABLE_CACHING=1 YTDL_NO_UPDATE=1 \
      FFMPEG_BIN="$ROOT/bin/ffmpeg" FFPROBE_BIN="$ROOT/bin/ffprobe" \
      setuidgid nobody nice -n 5 "$ROOT/lib/ld-linux-armhf.so.3" --library-path "$ROOT/lib" \
      "$ROOT/bin/node" $NODE_MEMORY "$ROOT/server.js" >> "$LOG" 2>&1 < /dev/null
    ;;
  watchdog)
    # Internal: started by "start".
    watchdog
    ;;
  stop)
    pid=$(watchdog_pid) && kill "$pid" 2>/dev/null
    rm -f "$WATCHPID"
    stop_server
    echo stopped
    ;;
  status)
    if server_pid >/dev/null; then echo running; else echo stopped; fi
    ;;
  *)
    echo "usage: $0 start|stop|status" >&2
    exit 2
    ;;
esac
